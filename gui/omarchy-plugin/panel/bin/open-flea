#!/usr/bin/env python3
"""Open flea on one path, then float and center only that new window."""

import json
import re
import subprocess
import sys
import time

CLASS = "com.thisisgm.flea"
ADDR = re.compile(r"0x[0-9a-fA-F]+\Z")
WIDTH = 875
HEIGHT = 600


def clients():
    proc = subprocess.run(
        ["hyprctl", "clients", "-j"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    try:
        data = json.loads(proc.stdout[:1_000_000])
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def flea_addrs():
    found = set()
    for row in clients():
        if not isinstance(row, dict) or row.get("class") != CLASS:
            continue
        addr = row.get("address")
        if isinstance(addr, str) and ADDR.fullmatch(addr):
            found.add(addr)
    return found


def dispatch(expr):
    subprocess.run(
        ["hyprctl", "dispatch", expr],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main():
    if len(sys.argv) != 2:
        raise SystemExit(1)
    path = sys.argv[1]
    if not path.startswith("/") or any(c in path for c in "\n\r\0"):
        raise SystemExit(1)
    before = flea_addrs()
    subprocess.Popen(
        ["flea", "--select", path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    addr = ""
    for _ in range(25):
        time.sleep(0.2)
        fresh = flea_addrs() - before
        if len(fresh) == 1:
            addr = next(iter(fresh))
            break
        if len(fresh) > 1:
            return
    if not addr:
        return
    win = "address:" + addr
    dispatch('hl.dsp.window.float({ window = "%s", action = "toggle" })' % win)
    dispatch('hl.dsp.window.resize({ window = "%s", x = %d, y = %d })' % (win, WIDTH, HEIGHT))
    dispatch('hl.dsp.window.center({ window = "%s" })' % win)


if __name__ == "__main__":
    main()
