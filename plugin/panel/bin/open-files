#!/usr/bin/env python3
"""Open the default file manager on one path, then float and center that new window."""

import json
import os
import re
import shlex
import subprocess
import sys
import time

ADDR = re.compile(r"0x[0-9a-fA-F]+\Z")
WIDTH = 875
HEIGHT = 600
FIELD = re.compile(r"^%[fFuUickdDnNvm]$|^%%$")


def clients():
    proc = subprocess.run(
        ["hyprctl", "clients", "-j"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    try:
        data = json.loads(proc.stdout[:1_000_000])
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def class_addrs(class_name):
    want = class_name.casefold()
    found = set()
    for row in clients():
        if not isinstance(row, dict):
            continue
        if str(row.get("class") or "").casefold() != want:
            continue
        addr = row.get("address")
        if isinstance(addr, str) and ADDR.fullmatch(addr):
            found.add(addr)
    return found


def dispatch(expr):
    subprocess.run(
        ["hyprctl", "dispatch", expr],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def data_dirs():
    dirs = []
    home = os.environ.get("HOME", "")
    if home:
        dirs.append(os.path.join(home, ".local", "share"))
    raw = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for part in raw.split(":"):
        if part and part not in dirs:
            dirs.append(part)
    return dirs


def find_desktop(name):
    if not name.endswith(".desktop") or "/" in name or name.startswith("."):
        return ""
    for root in data_dirs():
        path = os.path.join(root, "applications", name)
        if os.path.isfile(path):
            return path
    return ""


def desktop_exec(path):
    in_entry = False
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                in_entry = line == "[Desktop Entry]"
                continue
            if in_entry and line.startswith("Exec="):
                return line[len("Exec=") :]
    return ""


def launch_argv(exec_line, target):
    argv = []
    placed = False
    for part in shlex.split(exec_line):
        if part in ("%f", "%F", "%u", "%U"):
            argv.append(target)
            placed = True
            continue
        if FIELD.fullmatch(part):
            continue
        argv.append(part)
    if not argv:
        return []
    if os.path.basename(argv[0]) == "thunar" and "-w" not in argv and "--window" not in argv:
        argv = [argv[0], "-w", *argv[1:]]
    if not placed:
        argv.append(target)
    return argv


def default_launch(target):
    proc = subprocess.run(
        ["xdg-mime", "query", "default", "inode/directory"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        text=True,
    )
    name = proc.stdout.strip()
    if proc.returncode != 0 or not name or any(c in name for c in "\n\r\0"):
        return []
    desktop = find_desktop(name)
    if not desktop:
        return []
    return launch_argv(desktop_exec(desktop), target)


def main():
    if len(sys.argv) != 2:
        raise SystemExit(1)
    path = sys.argv[1]
    if not path.startswith("/") or any(c in path for c in "\n\r\0"):
        raise SystemExit(1)
    argv = default_launch(path)
    if not argv or not argv[0] or argv[0].startswith("-"):
        return
    class_name = os.path.basename(argv[0])
    before = class_addrs(class_name)
    subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    addr = ""
    for _ in range(25):
        time.sleep(0.2)
        fresh = class_addrs(class_name) - before
        if len(fresh) == 1:
            addr = next(iter(fresh))
            break
        if len(fresh) > 1:
            return
    if not addr:
        return
    win = "address:" + addr
    dispatch('hl.dsp.window.float({ window = "%s", action = "toggle" })' % win)
    dispatch('hl.dsp.window.resize({ window = "%s", x = %d, y = %d })' % (win, WIDTH, HEIGHT))
    dispatch('hl.dsp.window.center({ window = "%s" })' % win)


if __name__ == "__main__":
    main()
