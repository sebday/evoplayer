#!/usr/bin/env bash
# Build evoplayer and link the binary + desktop entry.
set -euo pipefail

EVOPLAYER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_BIN="${HOME}/.local/bin"
EVOPLAYER_LIB="${HOME}/.local/lib/evoplayer"
BUILD_DIR="${EVOPLAYER_ROOT}/.build"
PLUGIN_DST="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/evo.player"
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
DESKTOP_DST="${XDG_DATA_HOME:-$HOME/.local/share}/applications/evoplayer.desktop"

link_path() {
  local target="$1"
  local source="$2"
  mkdir -p "$(dirname "$target")"
  if [[ -d "$target" && ! -L "$target" ]]; then
    echo "evoplayer: refusing to replace directory ${target}; move it aside first" >&2
    exit 1
  fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    rm -f -- "$target"
  fi
  ln -sfn -- "$source" "$target"
}

mkdir -p "$BUILD_DIR" "$EVOPLAYER_LIB"
build_go() {
  if command -v go >/dev/null 2>&1; then
    go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if command -v mise >/dev/null 2>&1; then
    if mise exec go@1.24.2 -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer 2>/dev/null; then
      return 0
    fi
    mise exec -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if [[ -x "$BUILD_DIR/evoplayer" ]]; then
    echo "evoplayer: using existing ${BUILD_DIR}/evoplayer (go toolchain missing)" >&2
    return 0
  fi
  return 1
}
(
  cd "$EVOPLAYER_ROOT"
  if ! build_go; then
    echo "evoplayer: go toolchain required to build" >&2
    exit 1
  fi
  link_path "${EVOPLAYER_LIB}/evoplayer" "${BUILD_DIR}/evoplayer"
  link_path "${LOCAL_BIN}/evoplayer" "${EVOPLAYER_LIB}/evoplayer"

  # go install puts a copy on PATH via mise before ~/.local/bin; shadow it with the dev build.
  if command -v go >/dev/null 2>&1; then
    go_bin="$(go env GOBIN 2>/dev/null || true)"
    if [[ -z "$go_bin" ]]; then
      go_bin="$(go env GOPATH 2>/dev/null)/bin"
    fi
    if [[ -n "$go_bin" && "$go_bin" != "$LOCAL_BIN" ]]; then
      stale="${go_bin}/evoplayer"
      if [[ -e "$stale" || -L "$stale" ]]; then
        link_path "$stale" "${BUILD_DIR}/evoplayer"
        echo "shadowed stale go install: ${stale} -> ${BUILD_DIR}/evoplayer" >&2
      fi
    fi
  fi
)

link_path "$DESKTOP_DST" "${EVOPLAYER_ROOT}/share/evoplayer.desktop"

PLUGIN_SRC="${EVOPLAYER_ROOT}/gui/omarchy-plugin"
link_path "$PLUGIN_DST" "$PLUGIN_SRC"

if [[ -f "$SHELL_JSON" ]]; then
  python3 - "$SHELL_JSON" <<'PY'
import json, os, sys, tempfile
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    cfg = json.load(f)
if not isinstance(cfg, dict):
    sys.exit("evoplayer: shell.json is not an object; leaving it alone")

def has_player(items):
    return isinstance(items, list) and any(isinstance(w, dict) and w.get("id") == "evo.player" for w in items)

plugins = cfg.setdefault("plugins", [])
bar = cfg.setdefault("bar", {})
layout = bar.setdefault("layout", {}) if isinstance(bar, dict) else None
if not isinstance(plugins, list) or not isinstance(layout, dict):
    sys.exit("evoplayer: unexpected shell.json shape; leaving it alone")
changed = False
if not has_player(plugins):
    plugins.append({"id": "evo.player"})
    changed = True
if not any(has_player(section) for section in layout.values()):
    center = layout.setdefault("center", [])
    if not isinstance(center, list):
        sys.exit("evoplayer: bar.layout.center is not a list; leaving shell.json alone")
    center.append({"id": "evo.player"})
    changed = True
if changed:
    mode = os.stat(path).st_mode & 0o777
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".shell.json.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
PY
fi

echo "binary: ${LOCAL_BIN}/evoplayer -> ${EVOPLAYER_LIB}/evoplayer"
echo "apps menu: ${DESKTOP_DST}"
echo "plugin: ${PLUGIN_DST} -> ${PLUGIN_SRC}"
echo ""
echo "run: evoplayer"
echo "backend: evoplayer serve"
echo "reload shell plugins: omarchy-shell shell rescanPlugins"
echo "toggle panel: omarchy-shell shell toggle evo.player '{}'"
echo ""
echo "optional autostart (~/.config/hypr/autostart.lua):"
echo '  o.launch_on_start("evoplayer serve")'
