#!/usr/bin/env bash
# Build evoplayer and link the binary + desktop entry.
set -euo pipefail

EVOPLAYER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_BIN="${HOME}/.local/bin"
EVOPLAYER_LIB="${HOME}/.local/lib/evoplayer"
BUILD_DIR="${EVOPLAYER_ROOT}/.build"
PLUGIN_DST="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/evo.evoplayer"
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
DESKTOP_DST="${XDG_DATA_HOME:-$HOME/.local/share}/applications/evoplayer.desktop"

link_path() {
  local target="$1"
  local source="$2"
  mkdir -p "$(dirname "$target")"
  if [[ -e "$target" && ! -L "$target" ]]; then
    rm -rf "$target"
  fi
  ln -sfn "$source" "$target"
}

mkdir -p "$BUILD_DIR" "$EVOPLAYER_LIB"
build_go() {
  if command -v go >/dev/null 2>&1; then
    go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if command -v mise >/dev/null 2>&1; then
    if mise exec go@1.24.2 -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer 2>/dev/null; then
      return 0
    fi
    mise exec -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if [[ -x "$BUILD_DIR/evoplayer" ]]; then
    echo "evoplayer: using existing ${BUILD_DIR}/evoplayer (go toolchain missing)" >&2
    return 0
  fi
  return 1
}
(
  cd "$EVOPLAYER_ROOT"
  if ! build_go; then
    echo "evoplayer: go toolchain required to build" >&2
    exit 1
  fi
  link_path "${EVOPLAYER_LIB}/evoplayer" "${BUILD_DIR}/evoplayer"
  link_path "${LOCAL_BIN}/evoplayer" "${EVOPLAYER_LIB}/evoplayer"
)

bash "${EVOPLAYER_ROOT}/scripts/migrate-evoshell-data.sh"

link_path "$DESKTOP_DST" "${EVOPLAYER_ROOT}/share/evoplayer.desktop"

if [[ -L "$PLUGIN_DST" || -d "$PLUGIN_DST" ]]; then
  rm -rf "$PLUGIN_DST"
  echo "removed quickshell plugin ${PLUGIN_DST}" >&2
fi

if [[ -f "$SHELL_JSON" ]]; then
  python3 - "$SHELL_JSON" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    cfg = json.load(f)
cfg["plugins"] = [p for p in cfg.get("plugins", []) if p.get("id") != "evo.evoplayer"]
bar = cfg.get("bar", {})
layout = bar.get("layout", {})
for section in ("left", "center", "right"):
    layout[section] = [w for w in layout.get(section, []) if w.get("id") != "evo.evoplayer"]
with open(path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PY
fi

echo "binary: ${LOCAL_BIN}/evoplayer -> ${EVOPLAYER_LIB}/evoplayer"
echo "apps menu: ${DESKTOP_DST}"
echo ""
echo "run: evoplayer"
echo "backend: evoplayer serve"
echo ""
echo "optional autostart (~/.config/hypr/autostart.lua):"
echo '  o.launch_on_start("evoplayer serve")'
