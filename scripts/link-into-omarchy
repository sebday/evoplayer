#!/usr/bin/env bash
# Symlink evoplayer into omarchy-shell plugin paths.
set -euo pipefail

EVOPLAYER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_SRC="${EVOPLAYER_ROOT}/omarchy-plugin"
PLUGIN_DST="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/evo.evoplayer"
LOCAL_BIN="${HOME}/.local/bin"
EVOPLAYER_LIB="${HOME}/.local/lib/evoplayer"
BUILD_DIR="${EVOPLAYER_ROOT}/.build"
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
MENU_JSONC="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
DESKTOP_DST="${XDG_DATA_HOME:-$HOME/.local/share}/applications/evoplayer.desktop"

link_path() {
  local target="$1"
  local source="$2"
  mkdir -p "$(dirname "$target")"
  if [[ -e "$target" && ! -L "$target" ]]; then
    rm -rf "$target"
  fi
  ln -sfn "$source" "$target"
}

mkdir -p "$BUILD_DIR" "$EVOPLAYER_LIB"
build_go() {
  if command -v go >/dev/null 2>&1; then
    go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if command -v mise >/dev/null 2>&1; then
    if mise exec go@1.24.2 -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer 2>/dev/null; then
      return 0
    fi
    mise exec -- go build -o "$BUILD_DIR/evoplayer" ./cmd/evoplayer
    return 0
  fi
  if [[ -x "$BUILD_DIR/evoplayer" ]]; then
    echo "evoplayer: using existing ${BUILD_DIR}/evoplayer (go toolchain missing)" >&2
    return 0
  fi
  return 1
}
(
  cd "$EVOPLAYER_ROOT"
  if ! build_go; then
    echo "evoplayer: go toolchain required to build" >&2
    exit 1
  fi
  link_path "${EVOPLAYER_LIB}/evoplayer" "${BUILD_DIR}/evoplayer"
  link_path "${LOCAL_BIN}/evoplayer" "${EVOPLAYER_LIB}/evoplayer"
)

bash "${EVOPLAYER_ROOT}/scripts/migrate-evoshell-data.sh"

mkdir -p "$(dirname "$PLUGIN_DST")"
link_path "$PLUGIN_DST" "$PLUGIN_SRC"
link_path "${PLUGIN_DST}/panel" "${EVOPLAYER_ROOT}/qml/panel"
link_path "$DESKTOP_DST" "${PLUGIN_SRC}/evoplayer.desktop"

if [[ -f "$SHELL_JSON" ]]; then
  python3 - "$SHELL_JSON" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    cfg = json.load(f)
plugins = cfg.setdefault("plugins", [])
if not any(p.get("id") == "evo.evoplayer" for p in plugins):
    plugins.append({"id": "evo.evoplayer"})
bar = cfg.setdefault("bar", {})
layout = bar.setdefault("layout", {})
center = layout.setdefault("center", [])
if not any(w.get("id") == "evo.evoplayer" for w in center):
    insert_at = 0
    for i, w in enumerate(center):
        if w.get("id") == "omarchy.clock":
            insert_at = i
            break
    center.insert(insert_at, {"id": "evo.evoplayer"})
with open(path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PY
fi

if [[ -f "$MENU_JSONC" ]]; then
  if ! rg -q 'seb\.evoplayer' "$MENU_JSONC" 2>/dev/null; then
    echo "note: add menu entry manually to $MENU_JSONC:" >&2
    echo '  "command": "omarchy-shell shell toggle evo.evoplayer '\''{}'\''"' >&2
  fi
fi

echo "linked evoplayer omarchy plugin from ${PLUGIN_SRC} -> ${PLUGIN_DST}"
echo "binary: ${LOCAL_BIN}/evoplayer -> ${EVOPLAYER_LIB}/evoplayer"
echo ""
echo "apps menu: ${DESKTOP_DST} (symlinked from omarchy-plugin/evoplayer.desktop)"
echo ""
echo "optional trigger menu entry (~/.config/omarchy/extensions/omarchy-menu.jsonc):"
echo '  "trigger.evoplayer": {'
echo '    "icon": "󰎈",'
echo '    "label": "Music player",'
echo '    "action": "omarchy-shell shell toggle evo.evoplayer '\''{}'\''"'
echo '  }'
echo ""
echo "optional autostart (~/.config/hypr/autostart.lua):"
echo '  o.launch_on_start("evoplayer serve")'
echo ""
echo "next: omarchy-shell shell rescanPlugins"
