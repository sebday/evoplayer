#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root}"

if [[ "${EVOPLAYER_BACKEND:-}" != "cliamp" ]]; then
  echo "skip: set EVOPLAYER_BACKEND=cliamp to run cliamp bridge spike test"
  exit 0
fi

command -v cliamp >/dev/null || { echo "skip: cliamp not installed" >&2; exit 0; }

fail=0

if [[ ! -f "${root}/qml/panel/compat/CliampBridge.qml" ]]; then
  echo "fail: missing CliampBridge.qml" >&2
  fail=1
fi

if ! rg -q 'useCliampBackend|CliampBridge' "${root}/qml/panel/Service.qml"; then
  echo "fail: Service.qml missing cliamp backend wiring" >&2
  fail=1
fi

if ! rg -q 'EVOPLAYER_BACKEND' "${root}/AGENTS.md"; then
  echo "fail: AGENTS.md missing cliamp backend docs" >&2
  fail=1
fi

sock="${HOME}/.config/cliamp/cliamp.sock"
started_daemon=0
if ! test -S "$sock"; then
  cliamp --daemon >/dev/null 2>&1 &
  started_daemon=1
fi
cleanup() {
  if [[ "${started_daemon}" -eq 1 ]]; then
    pkill -f 'cliamp --daemon' 2>/dev/null || true
  fi
}
trap cleanup EXIT

for _ in $(seq 1 50); do
  if test -S "$sock"; then
    break
  fi
  sleep 0.1
done

if ! test -S "$sock"; then
  echo "fail: cliamp daemon socket not created" >&2
  exit 1
fi

if ! cliamp status --json | python3 -c '
import json, sys
data = json.load(sys.stdin)
assert data.get("ok") is True, data
print("cliamp status ok:", data.get("state"))
'; then
  echo "fail: cliamp status --json" >&2
  fail=1
fi

vis_line="$(timeout 5 cliamp visstream --fps 2 2>/dev/null | head -1 || true)"
if ! printf '%s\n' "$vis_line" | python3 -c '
import json, sys
line = sys.stdin.readline().strip()
assert line, "empty visstream line"
data = json.loads(line)
assert data.get("ok") is True, data
assert isinstance(data.get("bands"), list), data
print("cliamp visstream ok:", len(data["bands"]), "bands")
'; then
  echo "fail: cliamp visstream sample frame" >&2
  fail=1
fi

if [[ "${fail}" -ne 0 ]]; then
  exit 1
fi

echo "evoplayer cliamp bridge spike ok"
