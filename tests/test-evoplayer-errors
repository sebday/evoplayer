#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root}"

EVOPLAYER_BIN="${EVOPLAYER_BIN:-${root}/.build/evoplayer}"
if [[ ! -x "${EVOPLAYER_BIN}" ]]; then
  echo "building evoplayer..." >&2
  if command -v go >/dev/null 2>&1; then
    go build -o "${EVOPLAYER_BIN}" ./cmd/evoplayer/
  elif command -v mise >/dev/null 2>&1; then
    mise exec -- go build -o "${EVOPLAYER_BIN}" ./cmd/evoplayer/
  else
    echo "fail: go toolchain required" >&2
    exit 1
  fi
fi
export EVOPLAYER_BIN

failures=()
note_fail() {
  failures+=("$1")
  echo "FAIL: $1" >&2
}

echo "== qml: static delegate checks =="
if rg -n 'filetreePanel\.dashboard' qml/panel/panels/FiletreePanel.qml \
  | rg -v 'readonly property var dash:' >/dev/null 2>&1; then
  note_fail "FiletreePanel delegates reference filetreePanel.dashboard directly; use readonly property var dash"
fi

echo "== omarchy plugin static =="
if ! bash tests/test-omarchy-plugin; then
  note_fail "omarchy plugin static checks (tests/test-omarchy-plugin)"
fi

echo "== qml: panel syntax =="
if ! bash tests/test-evoplayer-qml-panel; then
  note_fail "player panel QML syntax (tests/test-evoplayer-qml-panel)"
fi

echo "== qml: quickshell smoke =="
if ! bash tests/test-evoplayer-qml-smoke; then
  note_fail "player panel quickshell load (tests/test-evoplayer-qml-smoke)"
fi

if [[ "${EVOPLAYER_CHECK_JOURNAL:-0}" == "1" ]] && command -v journalctl >/dev/null; then
  echo "== journal: omarchy-shell evoplayer noise =="
  since="${EVOPLAYER_JOURNAL_SINCE:-30 min ago}"
  journal="$(journalctl --user _COMM=omarchy-shell --since "${since}" --no-pager 2>/dev/null || true)"
  patterns=(
    'ReferenceError:.*filetreeQueueFolder'
    'ReferenceError:.*listFont'
    'TypeError:.*filetreePanel\.dashboard'
    'TypeError:.*undefined is not an object'
    'SectionPanel\.qml.*adoptFieldsetLegend'
    'Type DashboardModule unavailable'
    'Type WaveformViz unavailable'
    'player load error'
    'Expected token'
  )
  for pat in "${patterns[@]}"; do
    if echo "${journal}" | rg -q "${pat}"; then
      note_fail "journal matches /${pat}/ since ${since} — restart shell after fixes: omarchy restart shell"
    fi
  done
fi

if ((${#failures[@]} > 0)); then
  echo "" >&2
  echo "evoplayer error checks failed (${#failures[@]}):" >&2
  for f in "${failures[@]}"; do
    echo "  - ${f}" >&2
  done
  echo "" >&2
  echo "fix hints:" >&2
  echo "  mise exec -- go test -tags=integration ./tests/integration/... -run TestEnriched -v" >&2
  echo "  bash scripts/link-into-omarchy && omarchy restart shell" >&2
  echo "  EVOPLAYER_CHECK_JOURNAL=1 bash tests/test-evoplayer-errors  # include live journal scan" >&2
  exit 1
fi

echo "evoplayer error checks passed"
