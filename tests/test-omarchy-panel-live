#!/usr/bin/env bash
set -euo pipefail

# Opt-in live check: requires a running omarchy-shell session (Hyprland + Wayland).
# Not part of run-all.sh.

if [[ "${EVOPLAYER_SKIP_LIVE_PANEL:-0}" == "1" ]]; then
  echo "skip: EVOPLAYER_SKIP_LIVE_PANEL=1"
  exit 0
fi

omarchy_shell="$(command -v omarchy-shell 2>/dev/null || true)"
if [[ -z "${omarchy_shell}" ]]; then
  echo "skip: omarchy-shell not installed" >&2
  exit 0
fi

if ! "${omarchy_shell}" shell ping >/dev/null 2>&1; then
  echo "skip: omarchy-shell not running (shell ping failed)" >&2
  exit 0
fi

runtime="${XDG_RUNTIME_DIR:-/tmp}"
if [[ ! -S "${runtime}/evoplayer.sock" ]]; then
  echo "skip: evoplayer socket absent (${runtime}/evoplayer.sock)" >&2
  exit 0
fi

if ! command -v journalctl >/dev/null; then
  echo "skip: journalctl not available" >&2
  exit 0
fi

since="${EVOPLAYER_JOURNAL_SINCE:-5 min ago}"
journal="$(journalctl --user _COMM=omarchy-shell --since "${since}" --no-pager 2>/dev/null || true)"
patterns=(
  'player load error'
  'Type DashboardModule unavailable'
  'Type WaveformViz unavailable'
  'Expected token'
  'FAIL:'
)

for pat in "${patterns[@]}"; do
  if echo "${journal}" | rg -q "${pat}"; then
    echo "fail: journal matches /${pat}/ since ${since}" >&2
    exit 1
  fi
done

echo "evoplayer omarchy panel journal ok"
