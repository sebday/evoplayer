#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root}"

fail=0

[[ -f "${root}/omarchy-plugin/manifest.json" ]] || { echo "missing omarchy-plugin/manifest.json" >&2; fail=1; }
[[ -f "${root}/omarchy-plugin/BarWidget.qml" ]] || { echo "missing omarchy-plugin/BarWidget.qml" >&2; fail=1; }
[[ -f "${root}/qml/panel/compat/qmldir" ]] || { echo "missing qml/panel/compat/qmldir" >&2; fail=1; }
[[ -x "${root}/scripts/link-into-omarchy" ]] || { echo "missing scripts/link-into-omarchy" >&2; fail=1; }
[[ ! -f "${root}/scripts/link-into-evoshell" ]] || { echo "stale scripts/link-into-evoshell must be removed" >&2; fail=1; }

if ! python3 - <<'PY' "${root}/omarchy-plugin/manifest.json"
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    m = json.load(f)
assert m.get("id") == "seb.evoplayer"
kinds = m.get("kinds") or []
for kind in ("service", "panel", "bar-widget"):
    assert kind in kinds, kind
ep = m.get("entryPoints") or {}
for key in ("service", "panel", "barWidget"):
    assert key in ep, key
PY
then
  echo "fail: invalid omarchy-plugin/manifest.json" >&2
  fail=1
fi

if rg -q 'import ".*commons"' qml/panel 2>/dev/null; then
  echo "fail: qml/panel still imports legacy commons path" >&2
  rg 'import ".*commons"' qml/panel >&2 || true
  fail=1
fi

if rg -q 'evo\.panels\.player|evo\.sys\.|EVOSHELL|link-into-evoshell|evoCommand' qml/panel 2>/dev/null; then
  echo "fail: qml/panel still references evoshell identifiers" >&2
  rg 'evo\.panels\.player|evo\.sys\.|EVOSHELL|link-into-evoshell|evoCommand' qml/panel >&2 || true
  fail=1
fi

if rg -ni 'evoshell|link-into-evoshell|EVOSHELL|evo\.panels' \
  AGENTS.md README.md scripts internal cmd \
  tests \
  --glob '!test-omarchy-plugin' \
  --glob '!migrate-evoshell-data.sh' \
  2>/dev/null \
  | rg -v 'migrate-evoshell-data|legacy .evoshell/panel/player' >/dev/null; then
  echo "fail: repo still contains evoshell references outside allowed migration note" >&2
  rg -ni 'evoshell|link-into-evoshell|EVOSHELL|evo\.panels' \
    AGENTS.md README.md scripts internal cmd \
    tests \
    --glob '!test-omarchy-plugin' \
    --glob '!migrate-evoshell-data.sh' \
    2>/dev/null \
    | rg -v 'migrate-evoshell-data|legacy .evoshell/panel/player' >&2 || true
  fail=1
fi

if ! rg -q 'seb\.evoplayer|PluginIds\.pluginId' qml/panel/Service.qml qml/panel/Player.qml qml/panel/DashboardModule.qml 2>/dev/null; then
  echo "fail: core QML missing seb.evoplayer wiring" >&2
  fail=1
fi

if [[ "${fail}" -ne 0 ]]; then
  exit 1
fi

echo "evoplayer omarchy plugin static ok"
